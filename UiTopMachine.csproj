<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UiTopMachine</RootNamespace>
    <AssemblyName>UiTopMachine</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Description>工业上位机 - 上海寅铠（WinForms + MVVM）</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.7" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="HslCommunication" Version="12.9.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <!--
    VMControls 渲染控件（海康 VisionMaster 配套，纯托管 net Framework 程序集）：
    图像页 VmRenderControl 显示结果图（内置鼠标拖拽平移 + 滚轮缩放）。
    引擎 SDK（VM.Core/VM.PlatformSDKCS）不在主进程加载（net10.0 直引引擎已实证原生崩溃），
    检测仍走桥接进程；此引用仅为编译期类型（IImageData/控件），运行时依赖经 AssemblyResolve 兜底（Program.cs）
  -->
  <ItemGroup>
    <Reference Include="VMControls.RenderInterface">
      <HintPath>D:\visionmaster\VisionMaster4.4.0\Applications\myLibs\VMControls.RenderInterface.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VMControls.Winform.Release">
      <HintPath>D:\visionmaster\VisionMaster4.4.0\Applications\myLibs\VMControls.Winform.Release.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 顶栏公司 Logo 图片：随程序分发，运行时从 Resources 目录加载 -->
  <ItemGroup>
    <None Update="Resources\tittle.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 排除单元测试目录：tests 由独立测试项目编译，防止主项目 glob 误收测试代码 -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**" />
  </ItemGroup>

  <!-- 排除桥接工具目录：tools/VmVisionBridge 为独立 net48 项目（承载 VisionMaster SDK），不随主程序编译 -->
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <None Remove="tools\**" />
  </ItemGroup>

</Project>