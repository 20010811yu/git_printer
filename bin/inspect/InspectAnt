using System;
using System.Linq;
using System.Reflection;

// 临时工具：反射检查 AntdUI Button 的样式相关属性（用完即删）
class Program
{
    static void Main()
    {
        var asm = Assembly.LoadFrom(@"C:\Users\20010811\.nuget\packages\antdui\2.4.7\lib\net8.0-windows7.0\AntdUI.dll");
        var button = asm.GetExportedTypes().First(t => t.FullName == "AntdUI.Button");

        Console.WriteLine("==== AntdUI.Button 属性（仅 AntdUI 声明的）====");
        foreach (var p in button.GetProperties(BindingFlags.Public | BindingFlags.Instance)
                 .Where(p => p.DeclaringType!.FullName!.StartsWith("AntdUI")))
        {
            string access = p.CanWrite ? "get;set;" : "get;";
            Console.WriteLine("  [" + p.DeclaringType!.Name + "] " + p.Name + " : " + p.PropertyType.Name + " [" + access + "]");
        }
    }
}