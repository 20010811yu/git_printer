<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UiTopMachine</RootNamespace>
    <AssemblyName>UiTopMachine</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Description>工业上位机 - 进料抽屉监控系统（WinForms + MVVM）</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.7" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="HslCommunication" Version="12.9.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <!-- 排除单元测试目录：tests 由独立测试项目编译，防止主项目 glob 误收测试代码 -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>